from collections import deque

class Solution:
    def findOrder(self, n, prereq):
        g = [[] for _ in range(n)]
        indegree = [0] * n

        for a, b in prerequisites:
            g[b].append(a)
            indegree[a] += 1

        q = deque(i for i in range(n) if indegree[i] == 0)
        ans = []

        while q:
            u = q.popleft()
            ans.append(u)

            for v in g[u]:
                indegree[v] -= 1
                if indegree[v] == 0:
                    q.append(v)

        return ans if len(ans) == n else []
